# --- Stage 1 : build des dépendances ---
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements/base.txt requirements/prod.txt requirements/
RUN pip install --no-cache-dir --user -r requirements/prod.txt

# --- Stage 2 : image finale minimale ---
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf2.0-0 \
    libcairo2 \
    libmagic1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r django && useradd -r -g django django

WORKDIR /app
COPY --from=builder /root/.local /home/django/.local
COPY . .
RUN chown -R django:django /app
ENV PATH=/home/django/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod

USER django

# Railway injecte $PORT dynamiquement — collectstatic + migrate au démarrage
EXPOSE 8000
CMD python manage.py collectstatic --noinput && \
    python manage.py migrate --noinput && \
    daphne -b 0.0.0.0 -p ${PORT:-8000} config.asgi:application
