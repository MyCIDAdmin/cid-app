# =============================================================================
# CID — Clubistes in Deutschland — Variables d'environnement
# Copier ce fichier en .env (dev) et remplir les valeurs.
# En production, ces valeurs sont injectées via les variables d'environnement
# Railway (Project Settings → Variables) — ne jamais committer de vraies valeurs.
# =============================================================================

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Générer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-dev-secret-key-insecure-do-not-use-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Domaines autorisés pour CORS (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# --- Chiffrement AES-256 des champs sensibles (CIN, passeport, messages, TOTP) ---
# Générer avec: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_FIELD_KEY=changeme-32-bytes-base64-urlsafe-dev-key-only

# --- PostgreSQL ---
POSTGRES_DB=cid_db
POSTGRES_USER=cid_user
POSTGRES_PASSWORD=changeme_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Railway fournit automatiquement DATABASE_URL — utilisé en priorité si présent
DATABASE_URL=

# --- Redis ---
REDIS_PASSWORD=changeme_dev
REDIS_HOST=redis
REDIS_PORT=6379
# Railway fournit automatiquement REDIS_URL — utilisé en priorité si présent
REDIS_URL=

# --- Email (dev: MailHog / prod: API HTTPS Brevo (recommandé, voir BREVO_API_KEY) ou SMTP) ---
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@clubistes.de
# Ajouté le 2026-09-19 — si défini, prod.py bascule sur l'API HTTPS de Brevo (django-anymail) au
# lieu du SMTP ci-dessus : fonctionne même sur un plan Railway Free/Trial/Hobby, où le SMTP
# sortant est bloqué (uniquement débloqué sur le plan Pro). Clé API Brevo (Menu > SMTP & API >
# API Keys sur app.brevo.com), distincte de la clé/mot de passe SMTP utilisé par EMAIL_HOST_*
# ci-dessus — ne jamais committer de vraie valeur (voir CLAUDE.md §5).
BREVO_API_KEY=

# --- MinIO (stockage fichiers S3-compatible) ---
# MINIO_ENDPOINT : endpoint INTERNE utilisé par le backend pour parler à MinIO (ex. Railway :
# <service>.railway.internal:9000). Jamais résolvable depuis un navigateur.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_dev
MINIO_USE_SSL=False
MINIO_BUCKET_DEFAULT=cid-media
MINIO_BUCKET_JUSTIFICATIFS=justificatifs
MINIO_BUCKET_PRODUITS=produits
MINIO_BUCKET_EXPORTS=exports
# Manquait ici jusqu'au 2026-09-23 (oubli lors de l'ajout du module Projets & Actions le
# 2026-09-22) — settings/base.py retombe sur "projets" par défaut si absente, donc sans
# impact fonctionnel tant que ce nom par défaut convient, mais gardé explicite ici comme les
# autres buckets.
MINIO_BUCKET_PROJETS=projets
# MINIO_PUBLIC_ENDPOINT : endpoint PUBLIC (host[:port], sans schéma) du bucket produits,
# réellement joignable par le navigateur d'un membre (domaine public Railway attaché au
# service MinIO, ou reverse-proxy/CDN devant lui) — voir apps.boutique.storage.
# Sans cette variable, Produit.image.url utilise MINIO_ENDPOINT (interne) et les images ne
# s'affichent pas en dehors du réseau privé du backend (icône d'image cassée). En local,
# le nom d'hôte Docker Compose `minio` n'est pas non plus résolu par le navigateur de la
# machine hôte : mettre MINIO_PUBLIC_ENDPOINT=localhost:9000 (port publié par
# docker-compose.yml) pour tester l'affichage des images en développement.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=False

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

# --- Fan-Club (module communaute, synchronisation SerpApi/Google Sports — voir
# apps.communaute.services) : compte gratuit sur serpapi.com/users/sign_up (aucune carte
# bancaire requise, 250 recherches/mois). Sans SERPAPI_KEY, la synchronisation périodique
# du classement/calendrier ne fait rien (aucune erreur, juste un log). SERPAPI_LIGUE sert
# au tableau complet + derniers résultats (nom reconnu par le panneau Sports de Google).
# SERPAPI_SAISON généralement laissé vide (saison en cours calculée automatiquement).
SERPAPI_KEY=
SERPAPI_EQUIPE=Club Africain
SERPAPI_LIGUE=Tunisian Ligue Professionnelle 1
SERPAPI_SAISON=

# --- Passerelles de paiement (AHM-46) — laisser vide en dev tant que non configuré : le paiement
# en ligne (carte/PayPal) affiche alors une erreur, le virement SEPA (confirmation manuelle
# DF/Admin) continue de fonctionner sans ces clés.
# Stripe : clé secrète + secret(s) de signature webhook (Dashboard Stripe → Développeurs → Webhooks)
# STRIPE_WEBHOOK_SECRET accepte plusieurs valeurs séparées par des virgules (un whsec_... par
# endpoint enregistré — cotisations et boutique ont chacun leur propre URL/endpoint/secret) :
# ex. STRIPE_WEBHOOK_SECRET=whsec_xxx,whsec_yyy
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal : "sandbox" en dev/test, "live" en prod. Client ID/Secret + Webhook ID (Dashboard
# PayPal Developer → My Apps & Credentials → Webhooks)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- JWT (simplejwt) ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- 2FA ---
OTP_EMAIL_TTL_MIN=10
OTP_EMAIL_MAX_PER_10MIN=3

# --- Monitoring (optionnel en dev) ---
SENTRY_DSN=

# --- Celery ---
CELERY_BROKER_URL=redis://:changeme_dev@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme_dev@redis:6379/1

# --- Postgres/pgAdmin ports exposés en dev uniquement ---
POSTGRES_EXPOSED_PORT=5432
